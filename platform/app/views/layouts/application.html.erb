<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Veylora Access</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <header class="site-header">
      <nav class="navbar" aria-label="Main navigation">
        <%= link_to "Veylora Access", root_path, class: "navbar-brand" %>
        <%= link_to "Home", root_path, class: "navbar-link", aria: { current: "page" } %>
      </nav>
    </header>
    <main><%= yield %></main>
  </body>
</html>
